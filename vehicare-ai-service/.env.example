PORT=5000
NODE_ENV=development

# Gemini AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=25000

# Concurrency & Queue Configuration
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_QUEUE_SIZE=20
AI_MAX_QUEUE_WAIT_MS=10000

# Rate Limiting
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

# Model Cooldown
AI_MODEL_COOLDOWN_MS=30000

# Cache TTL Configuration (Seconds)
GENERAL_AI_CACHE_TTL_SECONDS=86400
DIAGNOSTIC_AI_CACHE_TTL_SECONDS=21600
REPAIR_GUIDE_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX_ENTRIES=500

# Internal Authentication Secret (Shared between Laravel and Node.js)
AI_SERVICE_SECRET=your_internal_ai_service_secret_here
