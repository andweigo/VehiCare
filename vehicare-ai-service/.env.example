PORT=5000
NODE_ENV=development

# Gemini AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Used as the default overall request budget and text timeout when specific values are not set.
GEMINI_TIMEOUT_MS=28000
AI_TOTAL_TIMEOUT_MS=28000
AI_TOTAL_IMAGE_TIMEOUT_MS=42000
AI_TOTAL_AUDIO_TIMEOUT_MS=60000
AI_TOTAL_VIDEO_TIMEOUT_MS=75000
AI_PRIMARY_TEXT_TIMEOUT=13500
AI_FALLBACK_TEXT_TIMEOUT=10500
AI_TEXT_TIMEOUT=13500
AI_IMAGE_TIMEOUT=22000
AI_FALLBACK_IMAGE_TIMEOUT=15000
AI_AUDIO_TIMEOUT=28000
AI_FALLBACK_AUDIO_TIMEOUT=16000
AI_VIDEO_TIMEOUT=38000
AI_FALLBACK_VIDEO_TIMEOUT=18000
AI_MEDIA_PROCESSING_TIMEOUT=35000
AI_MEDIA_POLL_INTERVAL=1500
AI_MAX_RETRIES=1

# Concurrency & Queue Configuration
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_QUEUE_SIZE=20
AI_MAX_QUEUE_WAIT_MS=10000

# Rate Limiting
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

# Model Cooldown
AI_MODEL_COOLDOWN_MS=30000

# Cache TTL Configuration (Seconds)
GENERAL_AI_CACHE_TTL_SECONDS=86400
DIAGNOSTIC_AI_CACHE_TTL_SECONDS=21600
REPAIR_GUIDE_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX_ENTRIES=500

# Internal Authentication Secret (Shared between Laravel and Node.js)
AI_SERVICE_SECRET=your_internal_ai_service_secret_here
