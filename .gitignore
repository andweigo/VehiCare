# ==========================================
# VehiCare Root .gitignore
# ==========================================

# 1. Environment & Configuration Files
.env
.env.*
!.env.example
*.env.local

# 2. Dependencies
node_modules/
vendor/
**/node_modules/
**/vendor/

# 3. React Native & Metro Build Artifacts
*.jsbundle
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.metro-health-check*
coverage/
android/link-assets-manifest.json
ios/link-assets-manifest.json
temp-debug.mjs

# 4. Android Build Artifacts & Native Generated Files
**/build/
**/.gradle/
**/.cxx/
**/.kotlin/
**/.navigation/
local.properties
*.keystore
!debug.keystore
*.apk
*.aab

# 5. iOS Build Artifacts
**/Pods/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# 6. Laravel Caches, Storage & Generated Files
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/bootstrap/cache/*.php
!backend/storage/**/.gitignore
!backend/bootstrap/cache/.gitignore
backend/public/storage
backend/public/build
backend/public/hot
backend/.phpunit.result.cache
backend/curl-test.php
backend/test-token.php

# 7. IDE, OS & Tool Caches
.vscode/
.idea/
.bundle/
.kilo/
.qodo/
.tmp/
.DS_Store
Thumbs.db